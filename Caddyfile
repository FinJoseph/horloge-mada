{
	frankenphp
	order php_server before file_server
	auto_https off
	admin off

	# The `Mercure` extension is enabled by default for the Caddyfile.
	# You do not need this section if you're not using Mercure.
	# mercure

	# The `XSendfile` extension is enabled by default for the Caddyfile.
	# xsendfile

	# Trust Render's proxy IPs so Laravel sees real client IPs
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}

	log {
		level WARN
	}
}

# Render injecte $PORT (défaut 10000) et y envoie le healthcheck.
# Liaison dynamique => pas de re-détection de port ni de timeout.
:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	# Security headers
	header {
		-X-Frame-Options SAMEORIGIN
		-X-Content-Type-Options nosniff
	}

	php_server {
	}
	file_server
}
